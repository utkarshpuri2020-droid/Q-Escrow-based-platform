# ==============================================================================
# Q-ESCROW CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Application Environment: development, staging, production
ENVIRONMENT=development
APP_NAME="Q-Escrow"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Session Secrets
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string-for-production
SESSION_EXPIRE_MINUTES=120
CSRF_SECRET_KEY=replace-with-another-secure-random-64-char-hex-for-csrf

# Database Configuration
# Local development default uses SQLite if DATABASE_URL is not set or set to sqlite:///./q_escrow.db
# For PostgreSQL production: postgresql+psycopg2://user:password@localhost:5432/q_escrow_db
DATABASE_URL=sqlite:///./q_escrow.db
DB_ECHO=false

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Post-Quantum Cryptography Configuration (NIST FIPS 204 ML-DSA)
# Supported parameter sets: ML-DSA-44, ML-DSA-65, ML-DSA-87
DEFAULT_ML_DSA_PARAMETER_SET=ML-DSA-65

# Blockchain & Smart Contract Configuration
# Local Hardhat/Anvil node URL: http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Set to 'true' to allow simulated blockchain confirmations when RPC node is unreachable
ALLOW_BLOCKCHAIN_SIMULATION=true
# Escrow Smart Contract Address (set after deployment script)
ESCROW_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Email Verification & Notifications
# Providers: console (prints verification tokens to log in dev), smtp, sendgrid
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@q-escrow.example.com

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_API_PER_MINUTE=100

# File Upload / Evidence Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
ALLOWED_EVIDENCE_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.doc,.docx

# Frontend Public Environment Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER_NAME="Q-Escrow Local Ledger Explorer"
NEXT_PUBLIC_DEFAULT_PQC_ALGO=ML-DSA-65
